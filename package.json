{
  "name": "alpine-glide-bookings",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "emulators:firestore": "firebase emulators:start --only firestore",
    "test:unit": "vitest run tests/unit",
    "test:integration": "firebase emulators:exec --only firestore \"vitest run tests/integration --no-file-parallelism --environment node\"",
    "test:e2e": "firebase emulators:exec --only firestore \"vitest run tests/integration/courseEnrollmentFlow.test.ts --no-file-parallelism --environment node\"",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/firestore.rules.test.ts --environment node\"",
    "test:storage-rules": "firebase emulators:exec --only storage \"vitest run tests/storage.rules.test.ts --environment node\"",
    "test": "npm run test:unit && npm run test:rules && npm run test:integration && npm run test:storage-rules",
    "test:all": "npm run test"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "firebase": "^10.12.0",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@firebase/rules-unit-testing": "^3.0.3",
    "@tailwindcss/vite": "^4.0.0-alpha.18",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "firebase-tools": "^13.35.1",
    "globals": "^15.13.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.0.0-alpha.18",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.2.12",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "universal-analytics": "0.5.3"
  }
}
