rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSystemOwner() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        ('systemRole' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.systemRole == 'owner';
    }

    function isAdmin() {
      return isSystemOwner() ||
        (isAuthenticated() &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    function isInstructor() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.instructorId is string;
    }

    function isAssignedInstructor(booking) {
      return isInstructor() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.instructorId == booking.instructorId;
    }

    function isOwnEmail(email) {
      return isAuthenticated() &&
        ('email' in request.auth.token) &&
        email is string &&
        email.lower() == request.auth.token.email.lower();
    }

    function availabilityMigrationComplete() {
      return exists(
        /databases/$(database)/documents/settings/availability_slots_migration
      ) &&
      get(
        /databases/$(database)/documents/settings/availability_slots_migration
      ).data.complete == true;
    }

    function bookingBlocksAvailability(booking) {
      return !booking.instructorId.matches('^course_.*') &&
        (!('isDeleted' in booking) || booking.isDeleted != true) &&
        booking.status in ['pending', 'confirmed', 'pending_cancellation'];
    }

    function validAvailabilitySlot(slot, bookingId, booking) {
      return slot.keys().hasAll([
          'bookingId',
          'instructorId',
          'date',
          'time',
          'durationHours',
          'slotType'
        ]) &&
        slot.keys().hasOnly([
          'bookingId',
          'instructorId',
          'date',
          'time',
          'durationHours',
          'slotType'
        ]) &&
        slot.bookingId == bookingId &&
        slot.instructorId == booking.instructorId &&
        slot.date == booking.date &&
        slot.time == booking.time &&
        slot.durationHours == booking.durationHours &&
        slot.durationHours > 0 &&
        slot.slotType in ['lesson', 'block'];
    }

    function availabilityIsSynchronized(bookingId, booking) {
      return bookingBlocksAvailability(booking)
        ? (
          existsAfter(
            /databases/$(database)/documents/availability_slots/$(bookingId)
          ) &&
          validAvailabilitySlot(
            getAfter(
              /databases/$(database)/documents/availability_slots/$(bookingId)
            ).data,
            bookingId,
            booking
          )
        )
        : !existsAfter(
          /databases/$(database)/documents/availability_slots/$(bookingId)
        );
    }

    function isMigratableClientBooking(booking) {
      return isAuthenticated() &&
        booking.userId.matches('^client_.*') &&
        exists(/databases/$(database)/documents/users/$(booking.userId)) &&
        isOwnEmail(
          get(
            /databases/$(database)/documents/users/$(booking.userId)
          ).data.email
        );
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || isInstructor();
      allow list: if isAdmin() || isInstructor() || isOwnEmail(resource.data.email);

      allow create: if (
        isOwner(userId) &&
        request.resource.data.uid == userId &&
        isOwnEmail(request.resource.data.email) &&
        request.resource.data.role == 'user' &&
        !('systemRole' in request.resource.data)
      ) || (
        isAdmin() &&
        userId.matches('^client_.*') &&
        request.resource.data.uid == userId &&
        !('systemRole' in request.resource.data) &&
        (request.resource.data.role != 'admin' || isSystemOwner())
      );

      allow update: if (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'phoneNumber',
          'avatarUrl',
          'balanceUSD',
          'hideProgressTracking'
        ]) &&
        request.resource.data.balanceUSD >= 0
      ) || (
        isInstructor() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'level',
          'skillScores'
        ])
      ) || (
        isAdmin() &&
        (!('role' in resource.data) || resource.data.role != 'admin') &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'systemRole'])
      ) || (
        isSystemOwner() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['systemRole'])
      );

      allow delete: if (
        isSystemOwner() &&
        (!('systemRole' in resource.data) || resource.data.systemRole != 'owner')
      ) || (
        isAdmin() &&
        (!('role' in resource.data) || resource.data.role != 'admin') &&
        (!('systemRole' in resource.data) || resource.data.systemRole != 'owner')
      ) || (
        userId.matches('^client_.*') &&
        (!('systemRole' in resource.data) || resource.data.systemRole != 'owner') &&
        isOwnEmail(resource.data.email)
      );
    }

    // Instructors
    match /instructors/{instructorId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewsCount']) &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.reviewsCount >= 0
      );
      allow delete: if isAdmin();
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow update: if (
        isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment']) &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5
      ) || (
        resource.data.userId.matches('^client_.*') &&
        request.resource.data.userId == request.auth.uid &&
        isOwnEmail(
          get(/databases/$(database)/documents/users/$(resource.data.userId)).data.email
        )
      ) || isAdmin();
      allow delete: if (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
    }

    // Bookings
    match /bookings/{bookingId} {
      allow read: if isAdmin() ||
        isOwner(resource.data.userId) ||
        isAssignedInstructor(resource.data) ||
        isMigratableClientBooking(resource.data) ||
        (isAuthenticated() && !availabilityMigrationComplete());

      allow create: if isAuthenticated() &&
        (request.resource.data.userId == request.auth.uid || isAdmin()) &&
        request.resource.data.totalPrice >= 0 &&
        request.resource.data.durationHours > 0 &&
        (isAdmin() || availabilityIsSynchronized(bookingId, request.resource.data));

      allow update: if (
        isOwner(resource.data.userId) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'date',
          'time',
          'cancellationReason'
        ]) &&
        (
          !availabilityMigrationComplete() ||
          availabilityIsSynchronized(bookingId, request.resource.data)
        )
      ) || (
        isAssignedInstructor(resource.data) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'date',
          'time',
          'cancellationReason'
        ]) &&
        (
          !availabilityMigrationComplete() ||
          availabilityIsSynchronized(bookingId, request.resource.data)
        )
      ) || (
        resource.data.userId.matches('^client_.*') &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId']) &&
        isOwnEmail(
          get(/databases/$(database)/documents/users/$(resource.data.userId)).data.email
        )
      ) || isAdmin();

      allow delete: if isAdmin();

      // Booking specific chat messages
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.userId == request.auth.uid ||
          isAdmin() ||
          isAssignedInstructor(
            get(/databases/$(database)/documents/bookings/$(bookingId)).data
          )
        );
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid &&
          (
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.userId == request.auth.uid ||
            isAdmin() ||
            isAssignedInstructor(
              get(/databases/$(database)/documents/bookings/$(bookingId)).data
            )
          );
        allow update, delete: if isAdmin();
      }
    }

    // Public schedule data without client names, IDs, prices, or notes.
    match /availability_slots/{bookingId} {
      allow read: if true;

      allow create, update: if isAdmin() || (
        isAuthenticated() &&
        existsAfter(/databases/$(database)/documents/bookings/$(bookingId)) &&
        (
          isOwner(
            getAfter(
              /databases/$(database)/documents/bookings/$(bookingId)
            ).data.userId
          ) ||
          isAssignedInstructor(
            getAfter(
              /databases/$(database)/documents/bookings/$(bookingId)
            ).data
          )
        ) &&
        validAvailabilitySlot(
          request.resource.data,
          bookingId,
          getAfter(
            /databases/$(database)/documents/bookings/$(bookingId)
          ).data
        )
      );

      allow delete: if isAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/bookings/$(bookingId)) &&
        (
          isOwner(
            get(
              /databases/$(database)/documents/bookings/$(bookingId)
            ).data.userId
          ) ||
          isAssignedInstructor(
            get(
              /databases/$(database)/documents/bookings/$(bookingId)
            ).data
          )
        ) &&
        (
          !existsAfter(/databases/$(database)/documents/bookings/$(bookingId)) ||
          !bookingBlocksAvailability(
            getAfter(
              /databases/$(database)/documents/bookings/$(bookingId)
            ).data
          )
        )
      );
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Courses
    match /courses/{courseId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availableSeats']) &&
        request.resource.data.availableSeats >= 0 &&
        request.resource.data.availableSeats <= resource.data.totalSeats &&
        (
          (
            request.resource.data.availableSeats == resource.data.availableSeats - 1 &&
            existsAfter(
              /databases/$(database)/documents/bookings/$('booking_course_' + request.auth.uid + '_' + courseId)
            ) &&
            getAfter(
              /databases/$(database)/documents/bookings/$('booking_course_' + request.auth.uid + '_' + courseId)
            ).data.userId == request.auth.uid
          ) || (
            request.resource.data.availableSeats == resource.data.availableSeats + 1 &&
            exists(
              /databases/$(database)/documents/bookings/$('booking_course_' + request.auth.uid + '_' + courseId)
            ) &&
            getAfter(
              /databases/$(database)/documents/bookings/$('booking_course_' + request.auth.uid + '_' + courseId)
            ).data.status == 'cancelled'
          )
        )
      );
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Error Logs
    match /error_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        isOwnEmail(request.resource.data.userEmail) &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 5000 &&
        request.resource.data.stack is string &&
        request.resource.data.stack.size() <= 20000;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Resort Data
    match /resort_data/{resortId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
