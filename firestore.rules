rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        (
          userId.matches('^client_.*') &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          isOwnEmail(get(/databases/$(database)/documents/users/$(userId)).data.email)
        )
      );
    }

    function isSystemOwner() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        ('systemRole' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.systemRole == 'owner';
    }

    function isAdmin() {
      return isSystemOwner() ||
        (isAuthenticated() &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    function hasCanonicalProvisioningMarker(course) {
      return course is map &&
        ('provisioningManifestFingerprint' in course) &&
        course.provisioningManifestFingerprint is string &&
        course.provisioningManifestFingerprint.size() > 0;
    }

    function hasStrictCanonicalCourseTopLevelShape(course) {
      return course is map &&
        course.keys().hasAll([
          'courseId',
          'title',
          'price',
          'capacity',
          'instructorRosterIds',
          'startAt',
          'scheduleProjection',
          'revision',
          'createdAt',
          'updatedAt',
          'audit'
        ]) &&
        course.keys().hasOnly([
          'courseId',
          'title',
          'price',
          'capacity',
          'instructorRosterIds',
          'startAt',
          'scheduleProjection',
          'provisioningManifestFingerprint',
          'provisioningExpectedCourseDayIds',
          'revision',
          'createdAt',
          'updatedAt',
          'audit'
        ]);
    }

    function canonicalCourseProtectedFromLegacyAdminWrites(course) {
      return hasCanonicalProvisioningMarker(course) ||
        hasStrictCanonicalCourseTopLevelShape(course);
    }

    function legacyAdminCourseWriteAllowed(course) {
      return !canonicalCourseProtectedFromLegacyAdminWrites(course);
    }

    function explicitlyScopedLiveClientCreate() {
      return request.resource.data.dataScope == 'live' &&
        !('testSessionId' in request.resource.data);
    }

    function authoritativeMoneyFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'balanceUSD',
        'walletBalances',
        'pendingWalletCredit',
        'lastRefundBookingId'
      ]);
    }

    function selfServiceAccountCreateHasNoMoneyFields() {
      return !('balanceUSD' in request.resource.data) &&
        !('walletBalances' in request.resource.data) &&
        !('pendingWalletCredit' in request.resource.data) &&
        !('lastRefundBookingId' in request.resource.data);
    }

    // T32.8A: Account/Instructor identity authority is command-only.
    function canonicalAccountAuthorityFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'lifecycle',
        'role',
        'systemRole',
        'instructorId',
        'isInstructor',
        'accountId',
        'revision',
        'audit',
        'createdAt',
        'updatedAt',
        'level',
        'skillScores',
        'skillComments'
      ]);
    }

    // Owner self-service is allowed only when the stored Account is proven active.
    // Missing lifecycle is the signup/legacy dual-write shape (create forbids
    // writing lifecycle). disable_account always writes canonical lifecycle.status.
    // Malformed maps, non-maps, and any status other than 'active' fail closed.
    // Uses resource.data so the client cannot bypass disable by omitting or
    // forging lifecycle on the request.
    function accountLifecycleAllowsSelfService() {
      return !('lifecycle' in resource.data) ||
        (
          resource.data.lifecycle is map &&
          resource.data.lifecycle.status == 'active'
        );
    }

    function selfServiceAccountCreateHasNoCanonicalAuthority() {
      return !('systemRole' in request.resource.data) &&
        !('instructorId' in request.resource.data) &&
        !('lifecycle' in request.resource.data) &&
        !('accountId' in request.resource.data) &&
        !('revision' in request.resource.data) &&
        !('audit' in request.resource.data) &&
        !('level' in request.resource.data) &&
        !('skillScores' in request.resource.data) &&
        !('skillComments' in request.resource.data) &&
        (!('isInstructor' in request.resource.data) || request.resource.data.isInstructor == false);
    }

    function validSelfServiceAccountCreate(userId) {
      return request.resource.data.uid == userId &&
        isOwnEmail(request.resource.data.email) &&
        request.resource.data.role == 'user' &&
        selfServiceAccountCreateHasNoCanonicalAuthority() &&
        selfServiceAccountCreateHasNoMoneyFields();
    }

    function validStarterCreditSetting() {
      let keys = request.resource.data.keys();
      return keys.hasOnly(['amountKzt']) &&
        request.resource.data.amountKzt is number &&
        request.resource.data.amountKzt >= 0 &&
        request.resource.data.amountKzt <= 10000;
    }

    function isInstructor() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.instructorId is string;
    }

    function isAssignedInstructor(booking) {
      return isInstructor() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.instructorId == booking.instructorId;
    }

    function isCourseGroupChatThread(threadId) {
      return exists(/databases/$(database)/documents/courses/$(threadId));
    }

    function isEnrolledInCourse(courseId) {
      return isAuthenticated() &&
        exists(
          /databases/$(database)/documents/course_chat_access/$(request.auth.uid)/courses/$(courseId)
        );
    }

    function isInstructorForCourse(courseId) {
      return isInstructor() &&
        exists(/databases/$(database)/documents/courses/$(courseId)) &&
        ('instructorIds' in get(/databases/$(database)/documents/courses/$(courseId)).data) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.instructorId in
          get(/databases/$(database)/documents/courses/$(courseId)).data.instructorIds;
    }

    function isActiveCourseEnrollmentBooking(booking) {
      return booking.instructorId.matches('^course_.*') &&
        booking.status != 'cancelled' &&
        (!('isDeleted' in booking) || booking.isDeleted != true);
    }

    function canAccessEnrollmentBookingChat(booking) {
      return isActiveCourseEnrollmentBooking(booking) &&
        (
          isOwner(booking.userId) ||
          (
            ('courseId' in booking) &&
            booking.courseId is string &&
            isInstructorForCourse(booking.courseId)
          )
        );
    }

    function isCanonicalBooking(booking) {
      return booking is map &&
        ('party' in booking) &&
        booking.party is map &&
        ('participantIds' in booking.party) &&
        booking.party.participantIds is list &&
        ('occurrence' in booking) &&
        booking.occurrence is map &&
        ('instructorId' in booking.occurrence) &&
        booking.occurrence.instructorId is string;
    }

    function isAssignedCanonicalInstructor(booking) {
      return isInstructor() &&
        isCanonicalBooking(booking) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.instructorId ==
          booking.occurrence.instructorId;
    }

    function managesParticipant(participantId) {
      return participantId is string &&
        exists(
          /databases/$(database)/documents/participant_management_active_owner/$(participantId)
        ) &&
        get(
          /databases/$(database)/documents/participant_management_active_owner/$(participantId)
        ).data.accountId == request.auth.uid;
    }

    function managesCanonicalBookingParticipantAt(booking, index) {
      return isCanonicalBooking(booking) &&
        booking.party.participantIds.size() > index &&
        managesParticipant(booking.party.participantIds[index]);
    }

    function managesAnyCanonicalBookingParticipant(booking) {
      return managesCanonicalBookingParticipantAt(booking, 0) ||
        managesCanonicalBookingParticipantAt(booking, 1) ||
        managesCanonicalBookingParticipantAt(booking, 2) ||
        managesCanonicalBookingParticipantAt(booking, 3) ||
        managesCanonicalBookingParticipantAt(booking, 4) ||
        managesCanonicalBookingParticipantAt(booking, 5) ||
        managesCanonicalBookingParticipantAt(booking, 6) ||
        managesCanonicalBookingParticipantAt(booking, 7);
    }

    function canAccessCanonicalBookingChat(booking) {
      return isAssignedCanonicalInstructor(booking) ||
        managesAnyCanonicalBookingParticipant(booking);
    }

    function canAccessLegacyBookingChat(booking) {
      return booking.userId == request.auth.uid ||
        isAssignedInstructor(booking) ||
        canAccessEnrollmentBookingChat(booking);
    }

    function canAccessBookingChat(booking) {
      return isCanonicalBooking(booking)
        ? canAccessCanonicalBookingChat(booking)
        : canAccessLegacyBookingChat(booking);
    }

    function canAccessChatMessages(threadId) {
      return isAdmin() ||
        (
          exists(/databases/$(database)/documents/bookings/$(threadId)) &&
          canAccessBookingChat(
            get(/databases/$(database)/documents/bookings/$(threadId)).data
          )
        ) ||
        (
          isCourseGroupChatThread(threadId) &&
          (isEnrolledInCourse(threadId) || isInstructorForCourse(threadId))
        );
    }

    function isOwnEmail(email) {
      return isAuthenticated() &&
        ('email' in request.auth.token) &&
        email is string &&
        email.lower() == request.auth.token.email.lower();
    }

    function availabilityMigrationComplete() {
      return exists(
        /databases/$(database)/documents/settings/availability_slots_migration
      ) &&
      get(
        /databases/$(database)/documents/settings/availability_slots_migration
      ).data.complete == true;
    }

    function bookingBlocksAvailability(booking) {
      return !booking.instructorId.matches('^course_.*') &&
        (!('isDeleted' in booking) || booking.isDeleted != true) &&
        booking.status in ['pending', 'confirmed', 'pending_cancellation'];
    }

    function isCancelledCourseBooking(booking) {
      return booking.instructorId.matches('^course_.*') &&
        (
          booking.status == 'cancelled' ||
          (('isDeleted' in booking) && booking.isDeleted == true)
        );
    }

    function hourLockDocId(instructorId, date, time) {
      return instructorId + '__' + date + '__' + time;
    }

    function availabilitySlotHasMatchingHourLock(bookingId, slot) {
      return existsAfter(
        /databases/$(database)/documents/availability_hour_locks/$(hourLockDocId(slot.instructorId, slot.date, slot.time))
      ) &&
      getAfter(
        /databases/$(database)/documents/availability_hour_locks/$(hourLockDocId(slot.instructorId, slot.date, slot.time))
      ).data.bookingId == bookingId;
    }

    function validAvailabilitySlot(slot, bookingId, booking) {
      return slot.keys().hasAll([
          'bookingId',
          'instructorId',
          'date',
          'time',
          'durationHours',
          'slotType'
        ]) &&
        slot.keys().hasOnly([
          'bookingId',
          'instructorId',
          'date',
          'time',
          'durationHours',
          'slotType'
        ]) &&
        slot.bookingId == bookingId &&
        slot.instructorId == booking.instructorId &&
        slot.date == booking.date &&
        slot.time == booking.time &&
        slot.durationHours == booking.durationHours &&
        slot.durationHours > 0 &&
        slot.slotType in ['lesson', 'block'];
    }

    function availabilityIsSynchronized(bookingId, booking) {
      return booking.status == 'cancelled' || booking.instructorId.matches('^course_.*') || (
        bookingBlocksAvailability(booking)
          ? (
            existsAfter(
              /databases/$(database)/documents/availability_slots/$(bookingId)
            ) &&
            validAvailabilitySlot(
              getAfter(
                /databases/$(database)/documents/availability_slots/$(bookingId)
              ).data,
              bookingId,
              booking
            )
          )
          : !existsAfter(
            /databases/$(database)/documents/availability_slots/$(bookingId)
          )
      );
    }

    function isSystemBlockBooking(booking) {
      return booking.userId.matches('^system_block_.*');
    }

    function isCourseBookingData(booking) {
      return booking.instructorId.matches('^course_.*');
    }

    function validBookingPrice(booking) {
      return isSystemBlockBooking(booking)
        ? booking.totalPrice == 0
        : isCourseBookingData(booking)
          ? (
            ('courseId' in booking) &&
            booking.courseId is string &&
            exists(/databases/$(database)/documents/courses/$(booking.courseId)) &&
            ('price' in get(/databases/$(database)/documents/courses/$(booking.courseId)).data) &&
            get(/databases/$(database)/documents/courses/$(booking.courseId)).data.price is number &&
            booking.totalPrice ==
              get(/databases/$(database)/documents/courses/$(booking.courseId)).data.price
          )
          : (
            exists(/databases/$(database)/documents/instructors/$(booking.instructorId)) &&
            ('pricePerHour' in get(/databases/$(database)/documents/instructors/$(booking.instructorId)).data) &&
            get(/databases/$(database)/documents/instructors/$(booking.instructorId)).data.pricePerHour is number &&
            booking.totalPrice ==
              get(/databases/$(database)/documents/instructors/$(booking.instructorId)).data.pricePerHour *
              booking.durationHours
          );
    }

    function bookingStatusUnchanged() {
      return request.resource.data.status == resource.data.status;
    }

    function bookingScheduleUnchanged() {
      return request.resource.data.date == resource.data.date &&
        request.resource.data.time == resource.data.time &&
        request.resource.data.instructorId == resource.data.instructorId;
    }

    function isMigratableClientBooking(booking) {
      return isAuthenticated() &&
        booking.userId.matches('^client_.*') &&
        exists(/databases/$(database)/documents/users/$(booking.userId)) &&
        isOwnEmail(
          get(
            /databases/$(database)/documents/users/$(booking.userId)
          ).data.email
        );
    }

    // User Profiles
    // Preserved client writes (non-authoritative only):
    // - create: signup / guest-claim migration (Auth.tsx, migratePreExistingProfile)
    // - update self presentation: today tasks, dismissReview, preferences
    //   (owner only, and only while stored Account lifecycle is active/absent)
    // Identity contact (phoneNumber) is canonical-command-only.
    // Canonical Wallet / Payment / MonetaryEvent are command-only.
    // Progress fields (level, skillScores, skillComments) are leftover
    // READ-ONLY LEGACY / CLEANUP CANDIDATE on /users. They are not authority.
    // Canonical progress lives on /participant_progress and is Admin SDK only.
    // New Account creates must not write leftover progress or money fields.
    match /users/{userId} {
      // Account documents are admin or self only. Instructor linkage
      // (users.instructorId) is not a grant to get or list other accounts.
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin() || (resource != null && isOwnEmail(resource.data.email));

      allow create: if isOwner(userId) && validSelfServiceAccountCreate(userId);

      allow update: if canonicalAccountAuthorityFieldsUnchanged() &&
        authoritativeMoneyFieldsUnchanged() &&
        isOwner(userId) &&
        accountLifecycleAllowsSelfService() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'avatarUrl',
          'hideProgressTracking',
          'hasCompletedOnboarding',
          'todaySkillItemIds',
          'completedTodayTaskIds',
          'completedTodayDate',
          'customTodayTasks',
          'dismissedTodayTaskIds',
          'dismissedReviewIds'
        ]);

      allow delete: if userId.matches('^client_.*') &&
        (!('systemRole' in resource.data) || resource.data.systemRole != 'owner') &&
        isOwnEmail(resource.data.email);

      // Canonical Account Wallet (`/users/{accountId}/wallet/state`): owner may read
      // own spendable balance for Header/cabinet. Client SDK never writes; Admin finance
      // reads go through callables, not direct browser access to other accounts' wallets.
      match /wallet/{walletDocId} {
        allow get: if (walletDocId == 'state') && isOwner(userId);
        allow list: if false;
        allow create, update, delete: if false;
      }
    }

    // Instructor catalog. Review aggregates, admin catalog fields, and phone
    // are server-owned. Self instructor phone is canonical-command-only.
    match /instructors/{instructorId} {
      allow read: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // T32.8A identity aggregates: client SDK cannot mutate; Admin SDK commands can.
    match /participants/{participantId} {
      allow read, write: if false;
    }

    match /participant_management/{managementId} {
      allow read, write: if false;
    }

    match /participant_blocks/{blockId} {
      allow read, write: if false;
    }

    match /instructor_relationships/{relationshipId} {
      allow read, write: if false;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read, write: if false;
    }

    // Canonical review authority and rating projection are callable/Admin SDK only.
    match /instructor_reviews/{reviewId} {
      allow read, write: if false;
    }

    match /instructor_rating_summaries/{instructorId} {
      allow read, write: if false;
    }

    match /participant_progress/{participantId} {
      allow read, write: if false;
    }

    match /participant_achievements/{participantId} {
      allow read, write: if false;
    }

    match /participant_lesson_feedback/{feedbackId} {
      allow read, write: if false;
    }

    // Server-owned guard read by security rules via get()/exists(); clients cannot read directly.
    match /participant_management_active_owner/{participantId} {
      allow read, write: if false;
    }

    // Bookings
    match /bookings/{bookingId} {
      allow read: if isAdmin() ||
        !exists(/databases/$(database)/documents/bookings/$(bookingId)) ||
        isOwner(resource.data.userId) ||
        isAssignedInstructor(resource.data) ||
        isMigratableClientBooking(resource.data) ||
        (isAuthenticated() && !availabilityMigrationComplete());

      // Booking documents are created by server Callables. Clients cannot insert bookings.
      allow create: if false;

      // Lifecycle status, schedule, and instructor assignment belong to Callables.
      // Canonical lesson feedback lives on /participant_lesson_feedback (callable only).
      // Legacy bookings.recommendations / completedRecommendationIds client writes are closed.
      allow update: if (
        resource.data.userId.matches('^client_.*') &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId']) &&
        isOwnEmail(
          get(/databases/$(database)/documents/users/$(resource.data.userId)).data.email
        )
      ) || (
        isAdmin() &&
        bookingStatusUnchanged() &&
        bookingScheduleUnchanged() &&
        request.resource.data.status != 'cancelled'
      );

      allow delete: if (
        isOwner(resource.data.userId) &&
        isCancelledCourseBooking(resource.data)
      );

      // Booking specific chat messages
      match /messages/{messageId} {
        allow read: if isAuthenticated() && canAccessChatMessages(bookingId);
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid &&
          canAccessChatMessages(bookingId) &&
          !('homeworkForUserIds' in request.resource.data);
        allow update: if isAdmin() || (
          isAuthenticated() &&
          resource.data.senderId == request.auth.uid &&
          canAccessChatMessages(bookingId) &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['isHomework', 'homeworkForParticipantIds']) &&
          !('homeworkForUserIds' in request.resource.data) &&
          (
            !('isHomework' in request.resource.data) ||
            request.resource.data.isHomework is bool
          ) &&
          (
            !('homeworkForParticipantIds' in request.resource.data) ||
            request.resource.data.homeworkForParticipantIds is list
          )
        );
        allow delete: if false;
      }
    }

    // Public schedule data without client names, IDs, prices, or notes.
    match /availability_slots/{bookingId} {
      allow read: if true;

      allow create, update, delete: if isAdmin();
    }

    // Hour-level locks used to prevent double-booking the same instructor slot.
    match /availability_hour_locks/{lockId} {
      // Public read: lock docs contain only instructor/date/time/bookingId (no client PII).
      allow read: if true;

      allow create, delete: if isAdmin();
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() &&
        settingId != 'guest_wallet' &&
        (
          settingId != 'starter_credit' ||
          validStarterCreditSetting()
        );
    }

    // Courses
    match /courses/{courseId} {
      allow read: if true;
      allow create: if isAdmin() &&
        explicitlyScopedLiveClientCreate() &&
        legacyAdminCourseWriteAllowed(request.resource.data);
      allow update, delete: if isAdmin() &&
        legacyAdminCourseWriteAllowed(resource.data);
    }

    // Non-authoritative course catalog/presentation content for public UI.
    match /course_catalog_content/{courseId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        explicitlyScopedLiveClientCreate() &&
        (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /activity_logs/{logId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Canonical commands write scoped activity logs through the Admin SDK.
      allow create, update, delete: if false;
    }

    // Wallet ledger is a historical read surface only. Clients cannot fabricate finance history.
    match /wallet_ledger/{entryId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // Canonical course-chat access projection. Written by enrollment commands (Admin SDK).
    match /course_chat_access/{accountId} {
      match /courses/{courseId} {
        allow read: if isAuthenticated() && (
          isAdmin() ||
          isInstructor() ||
          accountId == request.auth.uid
        );
        allow create, update, delete: if false;
      }
    }

    // Error Logs
    match /error_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        isOwnEmail(request.resource.data.userEmail) &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 5000 &&
        request.resource.data.stack is string &&
        request.resource.data.stack.size() <= 20000;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Idempotency records are written by Callables via the Admin SDK.
    match /function_idempotency/{id} {
      allow read, write: if false;
    }

    // AdminIssue inbox, Active/Pending lesson-booking, Planner, Courses,
    // Finance, People, and booking change-request invalidation signals.
    // Canonical backend writes only.
    match /admin_runtime/{documentId} {
      allow read: if isAdmin() && (
        documentId == 'admin_issue_inbox' ||
        documentId == 'admin_lesson_bookings' ||
        documentId == 'admin_planner' ||
        documentId == 'admin_courses' ||
        documentId == 'admin_finance' ||
        documentId == 'admin_people' ||
        documentId == 'admin_booking_change_requests'
      );
      allow write: if false;
    }

    // Resort Data
    match /resort_data/{resortId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
