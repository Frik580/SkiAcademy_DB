# Firebase web app configuration (Firebase Console → Project settings → Your apps)
# npm run dev is `vite --mode staging` and loads .env.staging (ski-school-staging).
# npm run build / npm run build:prod load production mode and must use ski-school-8f3ca.
# .env is shared by every mode; mode files override it. .env.staging is required for local dev.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=(default)
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
# Public reCAPTCHA v3 site key from Firebase Console → App Check.
# Required in hosting builds before executeGuestCanonicalCommand enforces App Check.
# Leave empty for emulator/E2E. Not a secret.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Playwright E2E (loaded via --mode e2e / .env.e2e)
# VITE_USE_FIREBASE_EMULATORS=true

# Google Stitch MCP (Cursor agent UI design tools)
# Set at user level or in local .env — never commit the real key.
# STITCH_API_KEY=
