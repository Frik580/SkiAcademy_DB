{
  "name": "ski-academy-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "npm --prefix ../packages/shared-domain run build && node scripts/syncSharedDomain.cjs && node ../scripts/writeFunctionsProvenance.mjs && tsc && node ../scripts/writeFunctionsProvenance.mjs --check",
    "backfill:attendance-outcome-work": "npm run build && node scripts/backfillBookingAttendanceOutcomeWork.cjs",
    "deploy:staging": "node ../scripts/runReleaseCommand.mjs functions:staging",
    "deploy:prod": "node ../scripts/runReleaseCommand.mjs functions:prod"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@ski-academy/shared-domain": "file:./shared-domain",
    "alpine-glide-bookings": "file:..",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1",
    "sharp": "^0.33.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
