rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAssignedInstructorForBooking(bookingId) {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.instructorId is string &&
        firestore.exists(/databases/(default)/documents/bookings/$(bookingId)) &&
        firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data.instructorId ==
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.instructorId;
    }

    function isCourseGroupChatThread(threadId) {
      return firestore.exists(/databases/(default)/documents/courses/$(threadId));
    }

    function isEnrolledInCourse(courseId) {
      return isAuthenticated() &&
        firestore.exists(
          /databases/(default)/documents/course_chat_access/$(request.auth.uid)/courses/$(courseId)
        );
    }

    function isInstructorForCourse(courseId) {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.instructorId is string &&
        firestore.exists(/databases/(default)/documents/courses/$(courseId)) &&
        ('instructorIds' in firestore.get(/databases/(default)/documents/courses/$(courseId)).data) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.instructorId in
          firestore.get(/databases/(default)/documents/courses/$(courseId)).data.instructorIds;
    }

    function isBookingParticipant(bookingId) {
      return isAuthenticated() && (
        isAdmin() ||
        (
          firestore.exists(/databases/(default)/documents/bookings/$(bookingId)) &&
          (
            firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data.userId == request.auth.uid ||
            isAssignedInstructorForBooking(bookingId)
          )
        ) ||
        (
          isCourseGroupChatThread(bookingId) &&
          (isEnrolledInCourse(bookingId) || isInstructorForCourse(bookingId))
        )
      );
    }

    function isValidImageUpload() {
      return request.resource.contentType.matches('image/.*') &&
        request.resource.size < 5 * 1024 * 1024;
    }

    function isValidVideoUpload() {
      return request.resource.contentType.matches('video/.*') &&
        request.resource.size < 50 * 1024 * 1024;
    }

    function isValidChatMediaUpload() {
      return isValidImageUpload() || isValidVideoUpload();
    }

    function isAllowedTestActor() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/test_actors/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/test_actors/$(request.auth.uid)).data.allowed == true;
    }

    function resourceScopeIsLive(data) {
      return !('dataScope' in data) || data.dataScope == 'live';
    }

    function isActiveTestSession(testSessionId) {
      return firestore.exists(/databases/(default)/documents/test_sessions/$(testSessionId)) &&
        firestore.get(/databases/(default)/documents/test_sessions/$(testSessionId)).data.status == 'active';
    }

    function isTestSessionMember(testSessionId) {
      return isAuthenticated() &&
        firestore.exists(
          /databases/(default)/documents/test_sessions/$(testSessionId)/membership/$(request.auth.uid)
        );
    }

    function canAccessTestSessionStorage(testSessionId) {
      return isActiveTestSession(testSessionId) &&
        isTestSessionMember(testSessionId) &&
        (isAllowedTestActor() || isAdmin());
    }

    function isTestBookingInSession(bookingId, testSessionId) {
      return firestore.exists(/databases/(default)/documents/bookings/$(bookingId)) &&
        firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data.dataScope == 'test' &&
        firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data.testSessionId == testSessionId;
    }

    function isTestCourseInSession(courseId, testSessionId) {
      return firestore.exists(/databases/(default)/documents/courses/$(courseId)) &&
        firestore.get(/databases/(default)/documents/courses/$(courseId)).data.dataScope == 'test' &&
        firestore.get(/databases/(default)/documents/courses/$(courseId)).data.testSessionId == testSessionId;
    }

    function isLiveChatThread(threadId) {
      return (
        !firestore.exists(/databases/(default)/documents/bookings/$(threadId)) ||
        resourceScopeIsLive(firestore.get(/databases/(default)/documents/bookings/$(threadId)).data)
      ) && (
        !firestore.exists(/databases/(default)/documents/courses/$(threadId)) ||
        resourceScopeIsLive(firestore.get(/databases/(default)/documents/courses/$(threadId)).data)
      );
    }

    function canAccessTestChatThread(testSessionId, threadId) {
      return canAccessTestSessionStorage(testSessionId) &&
        (
          (isTestBookingInSession(threadId, testSessionId) && isBookingParticipant(threadId)) ||
          (
            isTestCourseInSession(threadId, testSessionId) &&
            (isAdmin() || isEnrolledInCourse(threadId) || isInstructorForCourse(threadId))
          )
        );
    }

    match /avatars/{uid} {
      allow read: if true;
      allow write: if !isAllowedTestActor() && isOwner(uid) && isValidImageUpload();
    }

    // Participant-scoped avatars. Write authorization uses the active owner
    // guard so only the managing account can upload for that participantId.
    function canManageParticipantAvatar(participantId) {
      return isAuthenticated() &&
        firestore.exists(
          /databases/(default)/documents/participant_management_active_owner/$(participantId)
        ) &&
        firestore.get(
          /databases/(default)/documents/participant_management_active_owner/$(participantId)
        ).data.accountId == request.auth.uid;
    }

    match /participant-avatars/{participantId}/avatar.jpg {
      allow read: if true;
      allow write: if !isAllowedTestActor() && canManageParticipantAvatar(participantId) && isValidImageUpload();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if !isAllowedTestActor() && isAdmin() && isValidImageUpload();
    }

    match /instructors/{instructorId} {
      allow read: if true;
      allow write: if !isAllowedTestActor() && isAdmin() && isValidImageUpload();
    }

    match /chat/{bookingId}/{allPaths=**} {
      allow read: if !isAllowedTestActor() && isLiveChatThread(bookingId) && isBookingParticipant(bookingId);
      allow write: if !isAllowedTestActor() && isLiveChatThread(bookingId) && isBookingParticipant(bookingId) && isValidChatMediaUpload();
    }

    match /test-sessions/{testSessionId}/booking-chat/{bookingId}/{allPaths=**} {
      allow read: if canAccessTestChatThread(testSessionId, bookingId);
      allow write: if canAccessTestChatThread(testSessionId, bookingId) && isValidChatMediaUpload();
    }

    match /test-sessions/{testSessionId}/course-assets/{courseId}/{allPaths=**} {
      allow read: if canAccessTestSessionStorage(testSessionId) && isTestCourseInSession(courseId, testSessionId);
      allow write: if canAccessTestSessionStorage(testSessionId) &&
        isAdmin() &&
        isTestCourseInSession(courseId, testSessionId) &&
        isValidImageUpload();
    }

    match /test-sessions/{testSessionId}/misc/{allPaths=**} {
      allow read: if canAccessTestSessionStorage(testSessionId);
      allow write: if canAccessTestSessionStorage(testSessionId) && isValidImageUpload();
    }

    match /test-actors/{actorOrParticipantId}/{allPaths=**} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isOwner(actorOrParticipantId) ||
        canManageParticipantAvatar(actorOrParticipantId) ||
        isAllowedTestActor()
      );
      allow write: if isValidImageUpload() && (
        (isAllowedTestActor() && (isOwner(actorOrParticipantId) || canManageParticipantAvatar(actorOrParticipantId))) ||
        isAdmin()
      );
    }

    match /image-cache/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
