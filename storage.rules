rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid && isLivePrincipal();
    }

    // Mirrors parseAccountDocument's active Account projection (profile extras are ignored).
    function canonicalId(value) {
      return value is string && value.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$');
    }

    function canonicalInteger(value, minimum, maximum) {
      return value is number && value == math.floor(value) && value >= minimum && value <= maximum;
    }

    function canonicalTime(value) {
      return value is timestamp || (value is map &&
        canonicalInteger(value.seconds, -62135596800, 253402300799) &&
        canonicalInteger(value.nanoseconds, 0, 999999999));
    }

    function timeSeconds(value) { return value is timestamp ? value.seconds() : value.seconds; }
    function timeNanos(value) { return value is timestamp ? value.nanos() : value.nanoseconds; }
    function timeOrdered(left, right) {
      return timeSeconds(left) < timeSeconds(right) ||
        (timeSeconds(left) == timeSeconds(right) && timeNanos(left) <= timeNanos(right));
    }

    function canonicalActiveAccount(profile) {
      return profile != null && canonicalId(profile.accountId) &&
        profile.accountId == request.auth.uid && profile.role in ['user', 'admin'] &&
        profile.lifecycle is map && profile.lifecycle.keys().hasOnly(['status']) &&
        profile.lifecycle.status == 'active' &&
        canonicalInteger(profile.revision, 1, 9007199254740991) &&
        canonicalTime(profile.createdAt) && canonicalTime(profile.updatedAt) &&
        timeOrdered(profile.createdAt, profile.updatedAt) &&
        profile.audit is map && profile.audit.keys().hasOnly([
          'createdByCommandId', 'lastChangedByCommandId', 'correlationId'
        ]) && canonicalId(profile.audit.createdByCommandId) &&
        canonicalId(profile.audit.lastChangedByCommandId) && canonicalId(profile.audit.correlationId) &&
        (!('dataScope' in profile) || profile.dataScope in ['live', 'test']) &&
        (!('testSessionId' in profile) || canonicalId(profile.testSessionId));
    }

    function isLivePrincipal() {
      let profile = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      return canonicalActiveAccount(profile) && profile.get('dataScope', 'live') == 'live' &&
        !('testSessionId' in profile);
    }

    function administratorSessionAllowed(profile) {
      let revokedThrough = profile.get('adminSessionsRevokedThrough', null);
      let totpRequired = profile.get('adminTotpRequired', false);
      return (!('adminSessionsRevokedThrough' in profile) ||
          (revokedThrough is int && request.auth.token.auth_time is int &&
            request.auth.token.auth_time > revokedThrough)) &&
        (totpRequired == false ||
          (totpRequired == true &&
            request.auth.token.get('firebase', {}).get('sign_in_second_factor', '') == 'totp'));
    }

    function hasAdminSession() {
      let profile = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      return profile.get('role', '') == 'admin' && administratorSessionAllowed(profile);
    }

    function isAdmin() {
      return isAuthenticated() && isLivePrincipal() && hasAdminSession() && !isRegisteredTestActor();
    }

    function isRegisteredTestActor() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/test_actors/$(request.auth.uid));
    }

    // Historical public account avatars: reads are preserved for already stored
    // objects. Writes are closed because Rules can only see the client declared
    // contentType, never the bytes, and no current or historical client writes
    // this exact path (the legacy writer used `avatars/{uid}.jpg`, which the
    // owner check already denies). New account images go through protectedImages.
    match /avatars/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // Public LIVE images, with writes authorized by protectedImages.
    match /participant-avatars/{participantId}/avatar.jpg {
      allow read: if true;
      allow write: if false;
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if false;
    }

    // Immutable QR artifacts. Only the configured artifact is publicly readable;
    // draft previews use local browser URLs. No list, overwrite, metadata edit or deletion.
    match /kaspi-qr/{uploaderId}/{assetId} {
      allow create: if resource == null && isOwner(uploaderId) && isAdmin() &&
        assetId.matches('[0-9a-f-]{36}') && request.resource.size > 0 &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp'];
      allow get: if isAdmin() || (
        firestore.exists(/databases/(default)/documents/payment_configuration/kaspi_manual) &&
        firestore.get(/databases/(default)/documents/payment_configuration/kaspi_manual).data.get('qrStoragePath', '') ==
          'kaspi-qr/' + uploaderId + '/' + assetId
      );
      allow list, update, delete: if false;
    }

    // Catalog logos are immutable: replacements always create a new object.
    // Keep unused/replaced objects for safe manual cleanup after reconciliation;
    // clients cannot delete an object referenced by an in-flight command.
    match /lesson-levels/{levelId}/{uploaderId}/{assetId} {
      allow get: if true;
      allow create: if resource == null && isOwner(uploaderId) && isAdmin() &&
        levelId.matches('[a-z][a-z0-9_-]{0,79}') &&
        assetId.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}') &&
        request.resource.size > 0 && request.resource.size <= 2 * 1024 * 1024 &&
        request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp'];
      allow list, update, delete: if false;
    }

    match /instructors/{instructorId} {
      allow read: if true;
      allow write: if false;
    }

    match /chat/{bookingId}/{allPaths=**} {
      // bookingChatMedia verifies current canonical authority on every operation.
      // Direct SDK reads would also expose long-lived download tokens.
      allow read, write: if false;
    }

    // TEST images are served only by protectedImages with fresh canonical checks.
    match /test-sessions/{allPaths=**} { allow read, write: if false; }
    match /test-actors/{allPaths=**} { allow read, write: if false; }

    match /image-cache/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
