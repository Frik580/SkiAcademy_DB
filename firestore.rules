rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        (
          userId.matches('^client_.*') &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          isOwnEmail(get(/databases/$(database)/documents/users/$(userId)).data.email)
        )
      );
    }

    function isSystemOwner() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        ('systemRole' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.systemRole == 'owner';
    }

    function isAdmin() {
      return isSystemOwner() ||
        (isAuthenticated() &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    function hasCanonicalProvisioningMarker(course) {
      return course is map &&
        ('provisioningManifestFingerprint' in course) &&
        course.provisioningManifestFingerprint is string &&
        course.provisioningManifestFingerprint.size() > 0;
    }

    function legacyAdminCourseWriteAllowed() {
      return !hasCanonicalProvisioningMarker(resource.data);
    }

    function isInstructor() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.instructorId is string;
    }

    function isAssignedInstructor(booking) {
      return isInstructor() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.instructorId == booking.instructorId;
    }

    function isCourseGroupChatThread(threadId) {
      return exists(/databases/$(database)/documents/courses/$(threadId));
    }

    function isEnrolledInCourse(courseId) {
      return isAuthenticated() &&
        exists(
          /databases/$(database)/documents/bookings/$('booking_course_' + request.auth.uid + '_' + courseId)
        ) &&
        get(
          /databases/$(database)/documents/bookings/$('booking_course_' + request.auth.uid + '_' + courseId)
        ).data.userId == request.auth.uid &&
        get(
          /databases/$(database)/documents/bookings/$('booking_course_' + request.auth.uid + '_' + courseId)
        ).data.instructorId == 'course_' + courseId &&
        get(
          /databases/$(database)/documents/bookings/$('booking_course_' + request.auth.uid + '_' + courseId)
        ).data.status != 'cancelled' &&
        (
          !('isDeleted' in get(
            /databases/$(database)/documents/bookings/$('booking_course_' + request.auth.uid + '_' + courseId)
          ).data) ||
          get(
            /databases/$(database)/documents/bookings/$('booking_course_' + request.auth.uid + '_' + courseId)
          ).data.isDeleted != true
        );
    }

    function isInstructorForCourse(courseId) {
      return isInstructor() &&
        exists(/databases/$(database)/documents/courses/$(courseId)) &&
        ('instructorIds' in get(/databases/$(database)/documents/courses/$(courseId)).data) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.instructorId in
          get(/databases/$(database)/documents/courses/$(courseId)).data.instructorIds;
    }

    function isActiveCourseEnrollmentBooking(booking) {
      return booking.instructorId.matches('^course_.*') &&
        booking.status != 'cancelled' &&
        (!('isDeleted' in booking) || booking.isDeleted != true);
    }

    function canAccessEnrollmentBookingChat(booking) {
      return isActiveCourseEnrollmentBooking(booking) &&
        (
          isOwner(booking.userId) ||
          (
            ('courseId' in booking) &&
            booking.courseId is string &&
            isInstructorForCourse(booking.courseId)
          )
        );
    }

    function isCanonicalBooking(booking) {
      return booking is map &&
        ('party' in booking) &&
        booking.party is map &&
        ('participantIds' in booking.party) &&
        booking.party.participantIds is list &&
        ('occurrence' in booking) &&
        booking.occurrence is map &&
        ('instructorId' in booking.occurrence) &&
        booking.occurrence.instructorId is string;
    }

    function isAssignedCanonicalInstructor(booking) {
      return isInstructor() &&
        isCanonicalBooking(booking) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.instructorId ==
          booking.occurrence.instructorId;
    }

    function managesParticipant(participantId) {
      return participantId is string &&
        exists(
          /databases/$(database)/documents/participant_management_active_owner/$(participantId)
        ) &&
        get(
          /databases/$(database)/documents/participant_management_active_owner/$(participantId)
        ).data.accountId == request.auth.uid;
    }

    function managesCanonicalBookingParticipantAt(booking, index) {
      return isCanonicalBooking(booking) &&
        booking.party.participantIds.size() > index &&
        managesParticipant(booking.party.participantIds[index]);
    }

    function managesAnyCanonicalBookingParticipant(booking) {
      return managesCanonicalBookingParticipantAt(booking, 0) ||
        managesCanonicalBookingParticipantAt(booking, 1) ||
        managesCanonicalBookingParticipantAt(booking, 2) ||
        managesCanonicalBookingParticipantAt(booking, 3) ||
        managesCanonicalBookingParticipantAt(booking, 4) ||
        managesCanonicalBookingParticipantAt(booking, 5) ||
        managesCanonicalBookingParticipantAt(booking, 6) ||
        managesCanonicalBookingParticipantAt(booking, 7);
    }

    function canAccessCanonicalBookingChat(booking) {
      return isAssignedCanonicalInstructor(booking) ||
        managesAnyCanonicalBookingParticipant(booking);
    }

    function canAccessLegacyBookingChat(booking) {
      return booking.userId == request.auth.uid ||
        isAssignedInstructor(booking) ||
        canAccessEnrollmentBookingChat(booking);
    }

    function canAccessBookingChat(booking) {
      return isCanonicalBooking(booking)
        ? canAccessCanonicalBookingChat(booking)
        : canAccessLegacyBookingChat(booking);
    }

    function canAccessChatMessages(threadId) {
      return isAdmin() ||
        (
          exists(/databases/$(database)/documents/bookings/$(threadId)) &&
          canAccessBookingChat(
            get(/databases/$(database)/documents/bookings/$(threadId)).data
          )
        ) ||
        (
          isCourseGroupChatThread(threadId) &&
          (isEnrolledInCourse(threadId) || isInstructorForCourse(threadId))
        );
    }

    function isOwnEmail(email) {
      return isAuthenticated() &&
        ('email' in request.auth.token) &&
        email is string &&
        email.lower() == request.auth.token.email.lower();
    }

    function availabilityMigrationComplete() {
      return exists(
        /databases/$(database)/documents/settings/availability_slots_migration
      ) &&
      get(
        /databases/$(database)/documents/settings/availability_slots_migration
      ).data.complete == true;
    }

    function bookingBlocksAvailability(booking) {
      return !booking.instructorId.matches('^course_.*') &&
        (!('isDeleted' in booking) || booking.isDeleted != true) &&
        booking.status in ['pending', 'confirmed', 'pending_cancellation'];
    }

    function isCancelledCourseBooking(booking) {
      return booking.instructorId.matches('^course_.*') &&
        (
          booking.status == 'cancelled' ||
          (('isDeleted' in booking) && booking.isDeleted == true)
        );
    }

    function hourLockDocId(instructorId, date, time) {
      return instructorId + '__' + date + '__' + time;
    }

    function availabilitySlotHasMatchingHourLock(bookingId, slot) {
      return existsAfter(
        /databases/$(database)/documents/availability_hour_locks/$(hourLockDocId(slot.instructorId, slot.date, slot.time))
      ) &&
      getAfter(
        /databases/$(database)/documents/availability_hour_locks/$(hourLockDocId(slot.instructorId, slot.date, slot.time))
      ).data.bookingId == bookingId;
    }

    function validAvailabilitySlot(slot, bookingId, booking) {
      return slot.keys().hasAll([
          'bookingId',
          'instructorId',
          'date',
          'time',
          'durationHours',
          'slotType'
        ]) &&
        slot.keys().hasOnly([
          'bookingId',
          'instructorId',
          'date',
          'time',
          'durationHours',
          'slotType'
        ]) &&
        slot.bookingId == bookingId &&
        slot.instructorId == booking.instructorId &&
        slot.date == booking.date &&
        slot.time == booking.time &&
        slot.durationHours == booking.durationHours &&
        slot.durationHours > 0 &&
        slot.slotType in ['lesson', 'block'];
    }

    function availabilityIsSynchronized(bookingId, booking) {
      return booking.status == 'cancelled' || booking.instructorId.matches('^course_.*') || (
        bookingBlocksAvailability(booking)
          ? (
            existsAfter(
              /databases/$(database)/documents/availability_slots/$(bookingId)
            ) &&
            validAvailabilitySlot(
              getAfter(
                /databases/$(database)/documents/availability_slots/$(bookingId)
              ).data,
              bookingId,
              booking
            )
          )
          : !existsAfter(
            /databases/$(database)/documents/availability_slots/$(bookingId)
          )
      );
    }

    function isSystemBlockBooking(booking) {
      return booking.userId.matches('^system_block_.*');
    }

    function isCourseBookingData(booking) {
      return booking.instructorId.matches('^course_.*');
    }

    function validBookingPrice(booking) {
      return isSystemBlockBooking(booking)
        ? booking.totalPrice == 0
        : isCourseBookingData(booking)
          ? (
            ('courseId' in booking) &&
            booking.courseId is string &&
            exists(/databases/$(database)/documents/courses/$(booking.courseId)) &&
            ('price' in get(/databases/$(database)/documents/courses/$(booking.courseId)).data) &&
            get(/databases/$(database)/documents/courses/$(booking.courseId)).data.price is number &&
            booking.totalPrice ==
              get(/databases/$(database)/documents/courses/$(booking.courseId)).data.price
          )
          : (
            exists(/databases/$(database)/documents/instructors/$(booking.instructorId)) &&
            ('pricePerHour' in get(/databases/$(database)/documents/instructors/$(booking.instructorId)).data) &&
            get(/databases/$(database)/documents/instructors/$(booking.instructorId)).data.pricePerHour is number &&
            booking.totalPrice ==
              get(/databases/$(database)/documents/instructors/$(booking.instructorId)).data.pricePerHour *
              booking.durationHours
          );
    }

    function bookingStatusUnchanged() {
      return request.resource.data.status == resource.data.status;
    }

    function bookingScheduleUnchanged() {
      return request.resource.data.date == resource.data.date &&
        request.resource.data.time == resource.data.time &&
        request.resource.data.instructorId == resource.data.instructorId;
    }

    function isMigratableClientBooking(booking) {
      return isAuthenticated() &&
        booking.userId.matches('^client_.*') &&
        exists(/databases/$(database)/documents/users/$(booking.userId)) &&
        isOwnEmail(
          get(
            /databases/$(database)/documents/users/$(booking.userId)
          ).data.email
        );
    }

    function validBalanceDecreaseOnly() {
      let previousBalance =
        ('balanceUSD' in resource.data) && resource.data.balanceUSD is number
          ? resource.data.balanceUSD
          : 0;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balanceUSD']) &&
        request.resource.data.balanceUSD is number &&
        request.resource.data.balanceUSD >= 0 &&
        request.resource.data.balanceUSD < previousBalance;
    }

    function validRefundBalanceCreditApply(profileUserId) {
      let previousBalance =
        ('balanceUSD' in resource.data) && resource.data.balanceUSD is number
          ? resource.data.balanceUSD
          : 0;
      let previousPending =
        ('pendingWalletCredit' in resource.data) && resource.data.pendingWalletCredit is number
          ? resource.data.pendingWalletCredit
          : 0;
      let credit =
        ('balanceUSD' in request.resource.data) && request.resource.data.balanceUSD is number
          ? request.resource.data.balanceUSD - (previousBalance + previousPending)
          : 0;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'balanceUSD',
          'pendingWalletCredit',
          'lastRefundBookingId'
        ]) &&
        (!('pendingWalletCredit' in request.resource.data) ||
          request.resource.data.pendingWalletCredit == 0) &&
        ('lastRefundBookingId' in request.resource.data) &&
        request.resource.data.lastRefundBookingId is string &&
        credit >= 1 &&
        credit <= 10000 &&
        request.resource.data.balanceUSD == previousBalance + previousPending + credit &&
        exists(
          /databases/$(database)/documents/bookings/$(request.resource.data.lastRefundBookingId)
        ) &&
        get(
          /databases/$(database)/documents/bookings/$(request.resource.data.lastRefundBookingId)
        ).data.userId == profileUserId &&
        get(
          /databases/$(database)/documents/bookings/$(request.resource.data.lastRefundBookingId)
        ).data.status == 'cancelled' &&
        ('totalPrice' in get(
          /databases/$(database)/documents/bookings/$(request.resource.data.lastRefundBookingId)
        ).data) &&
        get(
          /databases/$(database)/documents/bookings/$(request.resource.data.lastRefundBookingId)
        ).data.totalPrice is number &&
        credit <= get(
          /databases/$(database)/documents/bookings/$(request.resource.data.lastRefundBookingId)
        ).data.totalPrice;
    }

    function validRefundLedgerCreate(entryId) {
      return request.resource.data.type == 'refund' &&
        ('bookingId' in request.resource.data) &&
        request.resource.data.bookingId is string &&
        request.resource.data.amount > 0 &&
        request.resource.data.amount <= 10000 &&
        request.resource.data.userId == request.auth.uid &&
        !exists(/databases/$(database)/documents/wallet_ledger/$(entryId)) &&
        exists(
          /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
        ) &&
        get(
          /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
        ).data.userId == request.auth.uid &&
        get(
          /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
        ).data.status == 'cancelled' &&
        ('totalPrice' in get(
          /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
        ).data) &&
        get(
          /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
        ).data.totalPrice is number &&
        request.resource.data.amount <= get(
          /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
        ).data.totalPrice;
    }

    function validPaymentLedgerCreate(entryId) {
      return (
        request.resource.data.type == 'lesson_payment' ||
        request.resource.data.type == 'course_payment'
      ) &&
        ('bookingId' in request.resource.data) &&
        request.resource.data.bookingId is string &&
        request.resource.data.amount < 0 &&
        request.resource.data.amount >= -10000 &&
        request.resource.data.userId == request.auth.uid &&
        !exists(/databases/$(database)/documents/wallet_ledger/$(entryId)) &&
        existsAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)) &&
        getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.userId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.totalPrice == -(request.resource.data.amount);
    }

    function validWalletLedgerEntryFields(entryId) {
      return request.resource.data.id == entryId &&
        request.resource.data.userId is string &&
        request.resource.data.amount is number &&
        request.resource.data.amount != 0 &&
        request.resource.data.balanceAfter is number &&
        request.resource.data.balanceAfter >= 0 &&
        request.resource.data.type is string &&
        request.resource.data.createdAt is string;
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || isInstructor();
      allow list: if isAdmin() || isInstructor() || (resource != null && isOwnEmail(resource.data.email));

      allow create: if (
        isOwner(userId) &&
        request.resource.data.uid == userId &&
        isOwnEmail(request.resource.data.email) &&
        request.resource.data.role == 'user' &&
        !('systemRole' in request.resource.data)
      ) || (
        isAdmin() &&
        userId.matches('^client_.*') &&
        request.resource.data.uid == userId &&
        !('systemRole' in request.resource.data) &&
        (request.resource.data.role != 'admin' || isSystemOwner())
      );

      allow update: if (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'phoneNumber',
          'avatarUrl',
          'hideProgressTracking',
          'hasCompletedOnboarding',
          'todaySkillItemIds',
          'completedTodayTaskIds',
          'completedTodayDate',
          'customTodayTasks',
          'dismissedTodayTaskIds',
          'dismissedReviewIds'
        ])
      ) || (
        isOwner(userId) && validBalanceDecreaseOnly()
      ) || (
        isInstructor() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'level',
          'skillScores',
          'skillComments'
        ])
      ) || (
        isAdmin() &&
        (!('role' in resource.data) || resource.data.role != 'admin') &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'systemRole'])
      ) || (
        isSystemOwner() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['systemRole'])
      );

      allow delete: if (
        isSystemOwner() &&
        (!('systemRole' in resource.data) || resource.data.systemRole != 'owner')
      ) || (
        isAdmin() &&
        (!('role' in resource.data) || resource.data.role != 'admin') &&
        (!('systemRole' in resource.data) || resource.data.systemRole != 'owner')
      ) || (
        userId.matches('^client_.*') &&
        (!('systemRole' in resource.data) || resource.data.systemRole != 'owner') &&
        isOwnEmail(resource.data.email)
      );
    }

    // Instructors
    match /instructors/{instructorId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewsCount']) &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.reviewsCount >= 0
      ) || (
        isInstructor() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.instructorId == instructorId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phoneNumber'])
      );
      allow delete: if isAdmin();
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow update: if (
        isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment']) &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5
      ) || (
        resource.data.userId.matches('^client_.*') &&
        request.resource.data.userId == request.auth.uid &&
        isOwnEmail(
          get(/databases/$(database)/documents/users/$(resource.data.userId)).data.email
        )
      ) || isAdmin();
      allow delete: if (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
    }

    // Server-owned guard read by security rules via get()/exists(); clients cannot read directly.
    match /participant_management_active_owner/{participantId} {
      allow read, write: if false;
    }

    // Bookings
    match /bookings/{bookingId} {
      allow read: if isAdmin() ||
        !exists(/databases/$(database)/documents/bookings/$(bookingId)) ||
        isOwner(resource.data.userId) ||
        isAssignedInstructor(resource.data) ||
        isMigratableClientBooking(resource.data) ||
        (isAuthenticated() && !availabilityMigrationComplete());

      // Booking documents are created by Callables (createBooking, addBooking,
      // createGuestBooking, enrollInCourse). Clients cannot insert bookings.
      allow create: if false;

      // Lifecycle status, schedule, and instructor assignment belong to Callables.
      // Clients may still update recommendations or link client_ bookings.
      allow update: if (
        isOwner(resource.data.userId) &&
        request.resource.data.userId == resource.data.userId &&
        bookingStatusUnchanged() &&
        bookingScheduleUnchanged() &&
        request.resource.data.status != 'cancelled' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'completedRecommendationIds'
        ])
      ) || (
        isAssignedInstructor(resource.data) &&
        request.resource.data.userId == resource.data.userId &&
        bookingStatusUnchanged() &&
        bookingScheduleUnchanged() &&
        request.resource.data.status != 'cancelled' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'recommendations'
        ])
      ) || (
        resource.data.userId.matches('^client_.*') &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId']) &&
        isOwnEmail(
          get(/databases/$(database)/documents/users/$(resource.data.userId)).data.email
        )
      ) || (
        isAdmin() &&
        bookingStatusUnchanged() &&
        bookingScheduleUnchanged() &&
        request.resource.data.status != 'cancelled'
      );

      allow delete: if isAdmin() || (
        isOwner(resource.data.userId) &&
        isCancelledCourseBooking(resource.data)
      );

      // Booking specific chat messages
      match /messages/{messageId} {
        allow read: if isAuthenticated() && canAccessChatMessages(bookingId);
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid &&
          canAccessChatMessages(bookingId);
        allow update: if isAdmin() || (
          isAuthenticated() &&
          resource.data.senderId == request.auth.uid &&
          canAccessChatMessages(bookingId) &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['isHomework', 'homeworkForUserIds']) &&
          (
            !('isHomework' in request.resource.data) ||
            request.resource.data.isHomework is bool
          ) &&
          (
            !('homeworkForUserIds' in request.resource.data) ||
            request.resource.data.homeworkForUserIds is list
          )
        );
        allow delete: if isAdmin();
      }
    }

    // Public schedule data without client names, IDs, prices, or notes.
    match /availability_slots/{bookingId} {
      allow read: if true;

      allow create, update, delete: if isAdmin();
    }

    // Hour-level locks used to prevent double-booking the same instructor slot.
    match /availability_hour_locks/{lockId} {
      // Public read: lock docs contain only instructor/date/time/bookingId (no client PII).
      allow read: if true;

      allow create, delete: if isAdmin();
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Courses
    match /courses/{courseId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() && legacyAdminCourseWriteAllowed();
    }

    // Non-authoritative course catalog/presentation content for public UI.
    match /course_catalog_content/{courseId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /activity_logs/{logId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.userId is string &&
        request.resource.data.actorId == request.auth.uid &&
        request.resource.data.type is string &&
        request.resource.data.timestamp is string &&
        (request.resource.data.userId == request.auth.uid || isAdmin() || isInstructor());
      // Idempotent setDoc for deterministic ids (e.g. act_level_{userId}_{level})
      allow update: if isAuthenticated() &&
        resource.data.actorId == request.auth.uid &&
        request.resource.data.actorId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.timestamp is string &&
        (request.resource.data.userId == request.auth.uid || isAdmin() || isInstructor());
      allow delete: if false;
    }

    // Wallet ledger (append-only operation history)
    match /wallet_ledger/{entryId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        validWalletLedgerEntryFields(entryId) &&
        (
          isAdmin() ||
          (
            request.resource.data.userId == request.auth.uid &&
            (
              (
                request.resource.data.type == 'lesson_payment' ||
                request.resource.data.type == 'course_payment'
              ) && validPaymentLedgerCreate(entryId)
            )
          )
        );
      allow update: if false;
      // Admin-only wipe for school finance reset; ledger remains append-only for all other clients.
      allow delete: if isAdmin();
    }

    // Error Logs
    match /error_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        isOwnEmail(request.resource.data.userEmail) &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 5000 &&
        request.resource.data.stack is string &&
        request.resource.data.stack.size() <= 20000;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Idempotency records are written by Callables via the Admin SDK.
    match /function_idempotency/{id} {
      allow read, write: if false;
    }

    // Resort Data
    match /resort_data/{resortId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
