{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with balance and user details",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "balanceUSD": { "type": "number" }
      },
      "required": ["uid", "email", "displayName", "role", "avatarUrl", "balanceUSD"]
    },
    "Instructor": {
      "title": "Instructor",
      "description": "Ski/snowboard instructor details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "specialty": { "type": "string" },
        "languages": { "type": "array" },
        "rating": { "type": "number" },
        "pricePerHour": { "type": "number" },
        "experienceYears": { "type": "number" },
        "bio": { "type": "string" },
        "imageUrl": { "type": "string" },
        "isAvailable": { "type": "boolean" },
        "reviewsCount": { "type": "number" }
      },
      "required": ["id", "name", "specialty", "languages", "rating", "pricePerHour", "experienceYears", "bio", "imageUrl", "isAvailable", "reviewsCount"]
    },
    "Review": {
      "title": "Review",
      "description": "Review for an instructor left by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "instructorId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "instructorId", "userId", "userName", "userAvatar", "rating", "comment", "createdAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Ski/snowboard lesson booking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "instructorId": { "type": "string" },
        "instructorName": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "hours": { "type": "number" },
        "totalPrice": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "instructorId", "instructorName", "date", "time", "hours", "totalPrice", "status", "createdAt"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Global application setting",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      },
      "required": ["enabled"]
    },
    "Course": {
      "title": "Course",
      "description": "Ski/snowboard group course",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "duration": { "type": "string" },
        "description": { "type": "string" },
        "dates": { "type": "string" },
        "totalSeats": { "type": "number" },
        "availableSeats": { "type": "number" },
        "price": { "type": "number" },
        "bgImageUrl": { "type": "string" },
        "isHidden": { "type": "boolean" }
      },
      "required": ["id", "title", "duration", "description", "dates", "totalSeats", "availableSeats", "price", "bgImageUrl"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "timestamp": { "type": "string" },
        "isRead": { "type": "boolean" }
      },
      "required": ["userId", "title", "message", "type", "timestamp", "isRead"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Booking specific chat message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookingId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderAvatar": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "bookingId", "senderId", "senderName", "senderAvatar", "text", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "User Profile"
    },
    "instructors/{instructorId}": {
      "schema": "Instructor",
      "description": "Instructor details"
    },
    "reviews/{reviewId}": {
      "schema": "Review",
      "description": "Review details"
    },
    "bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Booking details"
    },
    "bookings/{bookingId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Chat messages of a booking"
    },
    "settings/{settingId}": {
      "schema": "Setting",
      "description": "Global settings toggles"
    },
    "courses/{courseId}": {
      "schema": "Course",
      "description": "Course details"
    },
    "notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Notification details"
    }
  }
}
